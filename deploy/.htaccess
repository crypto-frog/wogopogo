# Wogopogo root .htaccess
# 1. Requests to /api/* go to the PHP API.
# 2. Real files (assets, favicon) are served as-is.
# 3. Public home and job routes use PHP renderers so their first response is
#    crawlable; the React application takes over for interactive visitors.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Keep one HTTPS canonical host so protocol and domain variants do not compete.
    RewriteCond %{HTTP_HOST} !^wogopogo\.ca$ [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://wogopogo.ca%{REQUEST_URI} [R=301,L,NE]

    # Redirect direct build-file URLs to their public canonical routes.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+post\.html(?:[?\s]) [NC]
    RewriteRule ^post\.html$ /post [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+manage\.html(?:[?\s]) [NC]
    RewriteRule ^manage\.html$ /manage [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+admin\.html(?:[?\s]) [NC]
    RewriteRule ^admin\.html$ /admin [R=301,L]

    RewriteRule ^api/ - [L]
    RewriteRule ^$ home.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^jobs/([0-9]+)/([a-z0-9-]+)/?$ job.php?id=$1&slug=$2 [L,QSA]
    RewriteRule ^jobs/([0-9]+)/?$ job.php?id=$1 [L,QSA]
    RewriteRule ^job/([0-9]+)/?$ job.php?id=$1 [L,QSA]
    RewriteRule ^post/?$ post.html [L]
    RewriteRule ^manage/?$ manage.html [L]
    RewriteRule ^admin/?$ admin.html [L]
    # Missing hashed assets must return a real 404, never the HTML application shell.
    RewriteRule ^assets/ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L,QSA]
</IfModule>

ErrorDocument 404 /404.php

# Baseline browser protections. These are supported by standard Bluehost Apache.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(admin|manage)(/|$)" wogo_private_page=1
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-Robots-Tag "noindex, nofollow" env=wogo_private_page

    <FilesMatch "^(?:index|post|manage|admin|404)\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    SetEnvIf Request_URI "^/assets/" wogo_hashed_asset
    Header set Cache-Control "public, max-age=31536000, immutable" env=wogo_hashed_asset

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
