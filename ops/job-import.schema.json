{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wogopogo.ca/schemas/job-import-v1.json",
  "title": "Wogopogo verified job import",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "generated_at", "policy", "jobs"],
  "properties": {
    "manifest_version": { "const": 1 },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_source_age_days"],
      "properties": {
        "max_source_age_days": { "type": "integer", "minimum": 1, "maximum": 365 }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key", "title", "company", "category_slug", "location", "job_type",
        "pay", "description", "apply_email", "apply_url", "status", "tier",
        "source_name", "source_url", "source_posted_at", "source_verified_at", "source_status"
      ],
      "properties": {
        "source_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._/-]{2,189}$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 90 },
        "company": { "type": "string", "minLength": 2, "maxLength": 90 },
        "category_slug": { "type": "string", "minLength": 1, "maxLength": 80 },
        "location": { "type": "string", "minLength": 1, "maxLength": 80 },
        "job_type": { "type": "string", "minLength": 1, "maxLength": 40 },
        "pay": { "type": "string", "maxLength": 90 },
        "description": { "type": "string", "minLength": 30, "maxLength": 6000 },
        "apply_email": { "type": "string", "maxLength": 160 },
        "apply_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "status": { "enum": ["pending", "approved"] },
        "tier": { "enum": ["free", "featured"] },
        "source_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_posted_at": { "type": "string", "format": "date" },
        "source_verified_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "source_status": { "enum": ["active", "unreachable", "unverified"] }
      }
    }
  }
}
